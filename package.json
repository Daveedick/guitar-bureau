{
  "name": "guitar-bureau-showroom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "serve .output/public --listen tcp://127.0.0.1:4173 --no-clipboard",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:assets": "node scripts/verify-assets.mjs",
    "postinstall": "nuxt prepare",
    "format": "prettier --write app tests scripts *.ts *.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.7",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
